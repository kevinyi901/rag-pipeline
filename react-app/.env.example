# Base URL of the RAG query API (no trailing slash, no /query suffix)
# e.g. http://localhost:8000  or  https://your-api.example.com
VITE_API_URL=http://localhost:8000

# Fallback passwords used ONLY when the API is unreachable (e.g. offline dev).
# When the API IS reachable these are ignored — the server checks LOGIN_PASS / DATA_ADD_PASS.
# Leave blank to disable the fallback (login will fail if the API is down).
VITE_LOGIN_PASS=
VITE_UPLOAD_PASS=
